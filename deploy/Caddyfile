# codecréa.com (nom de domaine accentué = xn--codecra-gya.com en punycode)
www.xn--codecra-gya.com {
	redir https://xn--codecra-gya.com{uri} permanent
}

xn--codecra-gya.com {
	root * /srv

	# Adresses sans .html : /realisations sert realisations.html,
	# et les anciennes adresses en .html sont redirigées (301) vers la version propre.
	@index path_regexp idx ^(.*/)index\.html$
	redir @index {re.idx.1} permanent
	@html path_regexp html ^(.+)\.html$
	redir @html {re.html.1} permanent
	try_files {path} {path}.html {path}/index.html
	encode zstd gzip
	file_server

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@static path /assets/*
	header @static Cache-Control "public, max-age=604800"

	# Page 404 personnalisée (le code 404 est conservé)
	handle_errors 404 {
		root * /srv
		rewrite * /404.html
		file_server
	}
}
